{
    "name": "api-service",
    "version": "1.0.0",
    "description": "Unified backend for auth, sync, and images.",
    "type": "module",
    "main": "index.js",
    "engines": {
        "node": ">=24 <25"
    },
    "scripts": {
        "native:setup": "(cd node_modules/better-sqlite3 && npm run install) && node node_modules/puppeteer/install.mjs",
        "start": "node index.js",
        "migrate:globals": "node scripts/migrate-globals.js",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage"
    },
    "dependencies": {
        "@panino/content-merge": "file:../../shared",
        "bcryptjs": "^2.4.3",
        "better-sqlite3": "^12.11.1",
        "cors": "^2.8.5",
        "dompurify": "^3.0.11",
        "express": "^4.19.2",
        "jsdom": "^24.1.0",
        "jsonwebtoken": "^9.0.2",
        "multer": "^1.4.5-lts.1",
        "node-fetch": "^3.3.2",
        "nodemailer": "^6.9.14",
        "pdf-lib": "^1.17.1",
        "puppeteer": "^25.5.0",
        "uuid": "^9.0.1",
        "ws": "^8.17.0",
        "yjs": "^13.6.32"
    },
    "devDependencies": {
        "@vitest/coverage-v8": "^2.0.0",
        "supertest": "^7.0.0",
        "vitest": "^2.0.0"
    }
}
