FROM node:24-bookworm-slim

# Native build deps for better-sqlite3 and runtime deps for the backend test suite
RUN apt-get update -o Acquire::Retries=5 \
	&& apt-get install -y --no-install-recommends \
		ca-certificates \
		fonts-liberation \
		libasound2 \
		libatk-bridge2.0-0 \
		libatk1.0-0 \
		libcairo2 \
		libcups2 \
		libdbus-1-3 \
		libexpat1 \
		libfontconfig1 \
		libgbm1 \
		libglib2.0-0 \
		libgtk-3-0 \
		libnspr4 \
		libnss3 \
		libpango-1.0-0 \
		libpangocairo-1.0-0 \
		libstdc++6 \
		libx11-6 \
		libx11-xcb1 \
		libxcb1 \
		libxcomposite1 \
		libxcursor1 \
		libxdamage1 \
		libxext6 \
		libxfixes3 \
		libxi6 \
		libxrandr2 \
		libxrender1 \
		libxss1 \
		libxtst6 \
		lsb-release \
		wget \
		xdg-utils \
		build-essential \
		python3 \
		pkg-config \
		libsqlite3-dev \
		git \
		unzip \
	&& rm -rf /var/lib/apt/lists/*

WORKDIR /app/backend/api-service

ENV PYTHON=/usr/bin/python3
ENV CRSQLITE_EXT_PATH=/app/backend/api-service/native/crsqlite.so
# Headless Shell supports the PDF test suite; avoid downloading full Chrome as well.
ENV PUPPETEER_CHROME_SKIP_DOWNLOAD=true

# Build context is the repository root (see scripts/test-backend.sh). Preserve
# the repository layout so npm can validate the `file:../../shared` lock target.
COPY backend/api-service/package.json backend/api-service/package-lock.json backend/api-service/.npmrc ./
COPY shared/package.json shared/package-lock.json /app/shared/
COPY shared/contentMerge.js /app/shared/
RUN cd /app/shared && npm ci --omit=dev

# .npmrc disables lifecycle scripts so better-sqlite3 is rebuilt and
# Puppeteer's browser is fetched explicitly in a deterministic order.
# CR-SQLite ships as a vendored prebuilt loadable extension.
RUN npm ci \
	&& npm run native:setup \
	&& ln -s "$(find /root/.cache/puppeteer/chrome-headless-shell -type f -name chrome-headless-shell -print -quit)" /usr/local/bin/chrome-headless-shell

ENV PUPPETEER_EXECUTABLE_PATH=/usr/local/bin/chrome-headless-shell

# Copy application code
COPY shared/ /app/shared/
COPY backend/api-service/ ./
COPY docker-compose.yml /app/docker-compose.yml

# Set test environment
ENV NODE_ENV=test
ENV JWT_SECRET=test-secret-do-not-use-in-production

# Run tests
CMD ["npm", "test"]
